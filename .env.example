BOIDS_API_KEY=
BOIDS_BASE_URL=https://api.boids.so/v1
BOIDS_AGENT_MODEL=agent:@shenjiayi0079-org/qq1006775897
BYTEPLUS_TTS_API_KEY=
BYTEPLUS_TTS_SPEAKER_ID=
BYTEPLUS_TTS_RESOURCE_ID=seed-icl-2.0

# Native Files use the same server-only BOIDS_API_KEY and BOIDS_BASE_URL.
# Set false to disable attachments without affecting text chat.
BOIDS_FILES_ENABLED=true
# Optional Mizzen real-time avatar. BOTH keys are server-only; never NEXT_PUBLIC_.
# With no keys, video mode is an explicitly labeled static preview, with normal text chat.
MIZZEN_BASE_URL=https://avatar.preview.mizzen.top
MIZZEN_INPUT_KEY=
MIZZEN_PLAYBACK_KEY=

# Private confirmation-card bridge; disabled until host/isolation are verified.
# Never put its Workspace key here or in NEXT_PUBLIC_ variables.
HANDOFF_ENABLED=false
HANDOFF_SUBMIT_ENABLED=false
HANDOFF_WRITE_ISOLATION_VERIFIED=false
HANDOFF_HOST_COMMAND=/opt/creekstone-handoff/bin/creekstone-handoff-host
HANDOFF_HOST_ENV_FILE=/etc/creekstone-handoff.env
