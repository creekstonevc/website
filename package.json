{
  "name": "creekstone-ventures-agent-experience",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build --webpack",
    "deploy": "bash deploy.sh",
    "gateway:dev": "node --env-file=.env.local gateway/server.mjs",
    "gateway:test": "node --test gateway/*.test.mjs",
    "start": "python3 -m http.server 3100 --directory out",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/space-grotesk": "^5.3.0",
    "@studio-freight/lenis": "^1.0.19",
    "gsap": "^3.12.2",
    "next": "^16.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.128.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^22.19.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.128.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3"
  }
}
